#!/bin/sh

set -eu
umask 077

script_dir=$(CDPATH='' cd -P -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH='' cd -P -- "$script_dir/.." && pwd)
workspace_dir="$repo_dir/.plazmic-ui-workspace/skin"

usage() {
  cat <<'EOF'
Usage: ./plazmic-ui <command> [options]

Commands:
  sync      Clone default_modern, improve it, format it, and lint it
  capture   Capture Plazmic UI or Aya plus a selected UI INI
  studio    Open the local drag-and-drop layout editor
  format    Format the materialized XML files
  lint      Lint the materialized UI
  install   Install the selected materialized UI beside default_modern
  publish   Publish edits for live /loadskin testing (creates backups)

Set EQ_LEGENDS_DIR or pass --game-dir to commands that access the game.
Run '<command> --help' for command-specific options.
EOF
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

command_name=$1
shift

case "$command_name" in
  sync)
    exec "$script_dir/sync-ui.sh" --destination "$workspace_dir" "$@"
    ;;
  capture)
    exec python3 "$script_dir/ui_studio.py" capture "$@"
    ;;
  studio)
    exec python3 "$script_dir/ui_studio.py" serve "$@"
    ;;
  format)
    exec "$script_dir/format-ui.sh" "$workspace_dir" "$@"
    ;;
  lint)
    if [ -f "$workspace_dir/.plazmic-upstream" ] && {
      grep -qx 'skin=aya' "$workspace_dir/.plazmic-upstream" ||
        grep -q '^captured_at=' "$workspace_dir/.plazmic-upstream"
    }; then
      exec python3 "$script_dir/lint-ui.py" \
        --profile generic \
        --inherited-include SIDL.xml \
        "$workspace_dir" "$@"
    fi
    exec python3 "$script_dir/lint-ui.py" --check-format "$workspace_dir" "$@"
    ;;
  install)
    exec "$script_dir/install-ui.sh" --source "$workspace_dir" "$@"
    ;;
  publish)
    exec python3 "$script_dir/ui_studio.py" publish "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
